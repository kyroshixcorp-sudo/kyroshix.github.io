// Preview/staging only. The worker name is deliberately NOT "releases" (production).
// Deploying this file never touches https://releases.kyroshixcorp.workers.dev/.
// Client-side deep links use native SPA fallback instead of _redirects rewrites.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kyroshix-preview",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
