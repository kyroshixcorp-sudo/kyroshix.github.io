// Preview/staging only. The worker name is deliberately NOT "releases" (production).
// Deploying this file never touches https://releases.kyroshixcorp.workers.dev/.
// "/" serves the Spatial UI homepage; unknown routes use SPA fallback to index.html.
// cloudflare/_redirects keeps the equivalent rewrites for the production Worker module.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kyroshix-preview",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
