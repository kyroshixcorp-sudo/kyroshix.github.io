// Preview/staging — NÃO é o Worker de produção "releases".
//
// Diferente da versão anterior (somente assets), agora existe um `main`: o Worker
// de APIs roda de verdade no preview. Sem isso, qualquer /api/* caía no
// not_found_handling e devolvia index.html com status 200, quebrando health,
// checkout, código por e-mail, catálogo, chat e sincronização de vídeos.
//
// O Worker trata apenas /api/* e delega todo o resto ao binding ASSETS, que
// serve ./dist com SPA fallback. patches.mjs fica vazio aqui; em produção o
// scripts/export-worker.py gera a versão com FILES/APP_ROUTES reais.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kyroshix-preview",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "vars": { "KX_PREVIEW_READ_ONLY": "true" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/health", "/api/drm/status",
      "/api/metrics", "/api/metrics/play", "/api/metrics/presence",
      "/api/auth/code", "/api/auth/verify",
      "/api/admin/code", "/api/admin/verify", "/api/admin/videos",
      "/api/billing/checkout", "/api/billing/confirm", "/api/billing/status", "/api/billing/webhook",
      "/api/catalog", "/api/videos", "/api/videos/sync", "/api/profile", "/api/chat"
    ]
  }
}
